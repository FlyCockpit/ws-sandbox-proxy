{
  "description": "placeholderEnv may reuse only its own entry name",
  "expect": "definition.invalid",
  "document": {
    "schemaVersion": 1,
    "id": "proxy",
    "displayName": "Proxy",
    "login": {
      "command": "true",
      "method": "paste"
    },
    "credentials": {
      "env": [
        {
          "name": "KEY",
          "required": true,
          "proxy": {
            "upstream": "https://api.example.com",
            "header": "Authorization",
            "format": "Bearer {value}",
            "baseUrlEnv": "KEY_BASE_URL"
          }
        },
        {
          "name": "KEY2",
          "required": false,
          "proxy": {
            "upstream": "https://api.example.com",
            "header": "X-Key",
            "format": "{value}",
            "baseUrlEnv": "KEY2_BASE_URL",
            "placeholderEnv": "KEY"
          }
        }
      ]
    }
  }
}
