// CLI logins ("bring your own CLI login"): docs/design/credential-vault.md and
// the CLI-logins plan §5. Owner-scoped. Ciphertext columns are selected only
// inside packages/api/src/credentials/vault/ (projection lint).
//
// Vocabulary: a login (`Credential`) pins one definition version; an account
// (`CredentialAccount`) is a provider account and owns pause; an instance
// (`CredentialInstance`) is one independent token set with its own vault
// value; a lease is one instance used by one sandbox or login session.

enum CredentialMode {
  EXCLUSIVE
  SHAREABLE
}

enum CredentialDelivery {
  GUEST
  PROXY
}

enum CredentialInstanceState {
  EMPTY
  READY
  NEEDS_LOGIN
}

enum CredentialSecretKind {
  UPLOAD
  LOGIN
  CAPTURE
  CHECKPOINT
  RECOVERY
  PROMOTED
  REPIN
}

enum CredentialLeaseKind {
  WORKLOAD
  LOGIN
}

/// Non-terminal: RESERVED, INSTALLING, ACTIVE, RELEASING, RECOVERY_REQUIRED,
/// RECOVERING. Terminal: RELEASED, FORCE_RELEASED, ABANDONED.
enum CredentialLeaseState {
  RESERVED
  INSTALLING
  ACTIVE
  RELEASING
  RELEASED
  RECOVERY_REQUIRED
  RECOVERING
  FORCE_RELEASED
  ABANDONED
}

enum CredentialBindingPurpose {
  INSTALL
  RECOVER
  LOGIN
}

enum CredentialCaptureOutcome {
  COMMITTED
  UNCHANGED
  DISCARDED
  REJECTED
}

enum CredentialLoginSessionState {
  PROVISIONING
  READY
  SAVING
  SAVED
  CANCELLED
  FAILED
  EXPIRED
}

/// One immutable version of an owner's login definition document.
model CredentialDefinition {
  id          String       @id @default(cuid(2))
  userId      String
  slug        String
  version     Int
  /// The verified document; the digest is recomputed whenever it is loaded for use.
  document    Json
  /// Lowercase hex SHA-256 of the canonical JSON document.
  digest      String
  displayName String
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  User        User         @relation("CredentialDefinitionOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  Credentials Credential[]
  // @check credential_definition_version: "version" >= 1
  // @check credential_definition_digest: "digest" ~ '^[0-9a-f]{64}$'

  @@unique([userId, slug, version])
  @@unique([id, userId])
  @@index([userId, slug, createdAt])
  @@index([userId, createdAt])
  @@map("credential_definition")
}

/// A login: one definition version plus settings.
model Credential {
  id                    String                      @id @default(cuid(2))
  userId                String
  name                  String
  definitionId          String
  /// Copied from the definition at pin time; recomputed on load.
  definitionDigest      String
  mode                  CredentialMode
  /// Immutable after create.
  delivery              CredentialDelivery
  copyBack              Boolean
  checkpointIntervalMin Int?
  foreignAllowed        Boolean                     @default(false)
  foreignAllowedAt      DateTime?
  foreignAllowedBy      String?
  deletedAt             DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @default(now()) @updatedAt
  User                  User                        @relation("CredentialOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  Definition            CredentialDefinition        @relation(fields: [definitionId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  Accounts              CredentialAccount[]
  Instances             CredentialInstance[]
  Leases                CredentialLease[]
  Attachments           SandboxCredential[]
  LoginSessions         CredentialLoginSession[]
  SdkKeyAllowlist       SdkKeyCredentialAllowlist[]
  // @check credential_proxy_copy_back: "delivery"::text <> 'PROXY' OR NOT "copyBack"
  // @check credential_checkpoint_interval: "checkpointIntervalMin" IS NULL OR ("checkpointIntervalMin" >= 5 AND "checkpointIntervalMin" <= 240)
  // @check credential_foreign_allowed: NOT "foreignAllowed" OR "foreignAllowedAt" IS NOT NULL
  // @check credential_pinned_digest: "definitionDigest" ~ '^[0-9a-f]{64}$'

  @@unique([userId, name])
  @@unique([id, userId])
  @@index([userId, createdAt])
  @@index([definitionId])
  @@map("credential")
}

/// A provider account declared by the owner. Pause lives here.
model CredentialAccount {
  id           String               @id @default(cuid(2))
  userId       String
  credentialId String
  ordinal      Int
  name         String?
  pausedAt     DateTime?
  pausedBy     String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  Credential   Credential           @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)
  User         User                 @relation("CredentialAccountOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  Instances    CredentialInstance[]
  // @check credential_account_ordinal: "ordinal" >= 1
  // @check credential_account_name: "name" IS NULL OR (length("name") >= 1 AND length("name") <= 80)

  @@unique([credentialId, ordinal])
  /// NULL names are distinct, so only named accounts are unique per login.
  @@unique([credentialId, name])
  @@unique([id, credentialId, userId])
  @@map("credential_account")
}

/// One independent token set with its own vault value.
model CredentialInstance {
  id               String                    @id @default(cuid(2))
  userId           String
  credentialId     String
  /// Immutable.
  accountId        String
  /// Denormalized from the account for the pick index.
  accountOrdinal   Int
  ordinal          Int
  name             String?
  /// Denormalized `account.pausedAt IS NOT NULL`, written only under the account lock.
  accountPaused    Boolean                   @default(false)
  /// EXCLUSIVE: 1. SHAREABLE: maxConcurrent, NULL = unlimited.
  capacity         Int?
  activeLeases     Int                       @default(0)
  /// Set while a login session holds the instance (login claim).
  loginLeaseId     String?
  currentSeq       Int?
  nextStorageSeq   Int                       @default(1)
  state            CredentialInstanceState   @default(EMPTY)
  needsLoginReason String?
  lastCapturedAt   DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @default(now()) @updatedAt
  User             User                      @relation("CredentialInstanceOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  Credential       Credential                @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)
  Account          CredentialAccount         @relation(fields: [accountId, credentialId, userId], references: [id, credentialId, userId], onDelete: Cascade, onUpdate: Restrict)
  Versions         CredentialSecretVersion[]
  Leases           CredentialLease[]
  // No upper bound on activeLeases: lowering maxConcurrent below current use is
  // allowed overcommit; it applies to new claims only.
  // @check credential_instance_active_leases: "activeLeases" >= 0
  // @check credential_instance_capacity: "capacity" IS NULL OR "capacity" >= 1
  // @check credential_instance_ordinal: "ordinal" >= 1 AND "accountOrdinal" >= 1 AND "nextStorageSeq" >= 1
  // @check credential_instance_name: "name" IS NULL OR (length("name") >= 1 AND length("name") <= 80)
  // @check credential_instance_ready: state::text <> 'READY' OR "currentSeq" IS NOT NULL
  // @check credential_instance_seq: "currentSeq" IS NULL OR ("currentSeq" >= 1 AND "currentSeq" < "nextStorageSeq")

  @@unique([accountId, ordinal])
  @@unique([accountId, name])
  @@unique([id, credentialId, userId])
  /// Auto-pick (no account named): account ordinal, then instance ordinal.
  @@index([credentialId, accountOrdinal, ordinal], map: "credential_instance_pick_any", where: raw("state = 'READY' AND NOT \"accountPaused\" AND \"loginLeaseId\" IS NULL AND (capacity IS NULL OR \"activeLeases\" < capacity)"))
  /// Account named: instance ordinal. Pause is checked by the caller.
  @@index([accountId, ordinal], map: "credential_instance_pick_account", where: raw("state = 'READY' AND \"loginLeaseId\" IS NULL AND (capacity IS NULL OR \"activeLeases\" < capacity)"))
  @@index([credentialId, accountId, ordinal])
  @@map("credential_instance")
}

/// Encrypted value versions. Columns other than the identity are vault-owned.
model CredentialSecretVersion {
  instanceId    String
  storageSeq    Int
  kind          CredentialSecretKind
  ciphertext    Bytes
  nonce         Bytes
  wrappedDek    Bytes
  wrapSalt      Bytes
  wrapNonce     Bytes
  rootKid       String
  policyDigest  String
  sizeBytes     Int
  sourceLeaseId String?
  createdAt     DateTime             @default(now())
  Instance      CredentialInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  // @check credential_secret_version_shape: "storageSeq" >= 1 AND "sizeBytes" >= 0 AND octet_length("nonce") = 12 AND octet_length("wrappedDek") = 48 AND octet_length("wrapSalt") = 32 AND octet_length("wrapNonce") = 12 AND "rootKid" ~ '^[0-9a-f]{16}$' AND "policyDigest" ~ '^[0-9a-f]{64}$'

  @@id([instanceId, storageSeq])
  @@index([rootKid])
  @@map("credential_secret_version")
}

/// One instance used by one sandbox (WORKLOAD) or one login session (LOGIN).
model CredentialLease {
  id                  String               @id @default(cuid(2))
  userId              String
  credentialId        String
  accountId           String
  instanceId          String
  sandboxId           String?
  loginSessionId      String?
  operationId         String
  kind                CredentialLeaseKind
  /// Denormalized `instance.capacity = 1` at claim; drives the partial unique.
  exclusive           Boolean
  state               CredentialLeaseState @default(RESERVED)
  /// Maintained write baseline: set at grant, advanced by every committed non-checkpoint capture.
  baseSeq             Int?
  hostId              String?
  currentBindingId    String?
  teardownOperationId String?
  captureSeqAccepted  Int                  @default(0)
  endReason           String?
  releasedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  User                User                 @relation("CredentialLeaseOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  Credential          Credential           @relation(fields: [credentialId, userId], references: [id, userId], onDelete: NoAction, onUpdate: Restrict)
  Instance            CredentialInstance   @relation(fields: [instanceId, credentialId, userId], references: [id, credentialId, userId], onDelete: NoAction, onUpdate: Restrict)
  Sandbox             Sandbox?             @relation(fields: [sandboxId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)
  Bindings            CredentialBinding[]
  // @check credential_lease_subject: ("kind"::text = 'WORKLOAD' AND "sandboxId" IS NOT NULL AND "loginSessionId" IS NULL) OR ("kind"::text = 'LOGIN' AND "loginSessionId" IS NOT NULL)
  // @check credential_lease_terminal: ("state"::text IN ('RELEASED', 'FORCE_RELEASED', 'ABANDONED')) = ("releasedAt" IS NOT NULL)
  // @check credential_lease_capture_seq: "captureSeqAccepted" >= 0

  /// The exclusive barrier: one non-terminal lease per exclusive instance.
  /// The predicate is spelled as PostgreSQL stores it, so a re-diff is empty
  /// and no later apply drops and recreates the index.
  @@unique([instanceId], map: "credential_lease_exclusive_live", where: raw("(exclusive AND (state = ANY (ARRAY['RESERVED'::\"CredentialLeaseState\", 'INSTALLING'::\"CredentialLeaseState\", 'ACTIVE'::\"CredentialLeaseState\", 'RELEASING'::\"CredentialLeaseState\", 'RECOVERY_REQUIRED'::\"CredentialLeaseState\", 'RECOVERING'::\"CredentialLeaseState\"])))"))
  @@index([sandboxId, state])
  @@index([instanceId, state])
  @@index([credentialId, state])
  @@index([userId, createdAt])
  @@map("credential_lease")
}

/// One grant of an instance's value to one host for one lease. Captures are
/// authorized by bindings, never by sandbox generations. Immutable except close.
model CredentialBinding {
  id                  String                   @id @default(cuid(2))
  leaseId             String
  instanceId          String
  sandboxId           String?
  hostId              String
  grantGeneration     Int
  operationId         String?
  /// Install request idempotency: one binding per (lease, requestId).
  requestId           String?
  baseSeq             Int?
  purpose             CredentialBindingPurpose
  recoveryOfBindingId String?
  createdAt           DateTime                 @default(now())
  closedAt            DateTime?
  closeReason         String?
  Lease               CredentialLease          @relation(fields: [leaseId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  Residue             CredentialResidue?

  @@unique([leaseId, requestId])
  @@index([leaseId])
  @@map("credential_binding")
}

/// A guest disk may hold one binding's files.
model CredentialResidue {
  id              String            @id @default(cuid(2))
  sandboxId       String
  userId          String
  credentialId    String
  instanceId      String
  leaseId         String
  bindingId       String            @unique
  grantGeneration Int
  /// Home-relative paths from the verified definition at grant.
  paths           Json
  recoverable     Boolean
  createdAt       DateTime          @default(now())
  clearedAt       DateTime?
  clearReason     String?
  User            User              @relation("CredentialResidueOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  Sandbox         Sandbox           @relation(fields: [sandboxId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)
  Binding         CredentialBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([sandboxId], map: "credential_residue_uncleared", where: raw("\"clearedAt\" IS NULL"))
  @@map("credential_residue")
}

/// Capture ledger: replays are matched on (captureId, envelopeDigest).
model CredentialCapture {
  captureId      String                   @id
  leaseId        String
  bindingId      String
  captureSeq     Int
  kind           String
  kidR           String
  envelopeDigest Bytes
  outcome        CredentialCaptureOutcome
  reason         String?
  storageSeq     Int?
  at             DateTime                 @default(now())
  // @check credential_capture_digest: octet_length("envelopeDigest") = 32

  @@unique([leaseId, captureSeq])
  @@map("credential_capture")
}

/// Unresolved envelopes a complete census listed; deleted on ack.
model CredentialPendingCapture {
  hostId     String
  captureId  String
  leaseId    String
  bindingId  String
  kidR       String
  kind       String
  reportedAt DateTime    @default(now())
  Host       SandboxHost @relation(fields: [hostId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([hostId, captureId])
  @@index([leaseId])
  @@map("credential_pending_capture")
}

/// Last complete census per host connection epoch.
model CredentialHostCensus {
  hostId           String      @id
  connectionEpoch  BigInt
  keyEpoch         BigInt
  quarantinedCount Int         @default(0)
  completedAt      DateTime
  Host             SandboxHost @relation(fields: [hostId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("credential_host_census")
}

/// Leases removed by account deletion on hosts that survive it. No user FK.
model CredentialLeaseTombstone {
  hostId    String
  leaseId   String
  reason    String
  createdAt DateTime    @default(now())
  Host      SandboxHost @relation(fields: [hostId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([hostId, leaseId])
  @@map("credential_lease_tombstone")
}

/// Server return keypairs (X25519). Exactly one is current (retiredAt NULL).
model CredentialReturnKey {
  kidR           String    @id
  epoch          BigInt    @unique
  publicKey      Bytes
  wrappedPrivate Bytes
  rwrapSalt      Bytes
  wrapNonce      Bytes
  rootKid        String
  createdAt      DateTime  @default(now())
  retiredAt      DateTime?
  destroyedAt    DateTime?
  // @check credential_return_key_shape: "kidR" ~ '^[0-9a-f]{16}$' AND "epoch" >= 1 AND octet_length("publicKey") = 32 AND octet_length("rwrapSalt") = 32 AND octet_length("wrapNonce") = 12 AND "rootKid" ~ '^[0-9a-f]{16}$'

  @@unique([retiredAt], map: "credential_return_key_current", where: raw("\"retiredAt\" IS NULL"))
  @@index([rootKid])
  @@map("credential_return_key")
}

/// Singleton serializing issuance (FOR SHARE) against rotation/destruction (FOR UPDATE).
model CredentialReturnKeyState {
  id           Int    @id
  currentKidR  String
  currentEpoch BigInt
  // @check credential_return_key_state_singleton: "id" = 1 AND "currentEpoch" >= 1

  @@map("credential_return_key_state")
}

/// Issuance record: committed before the key frame is sent.
model CredentialHostReturnKey {
  hostId         String
  kidR           String
  epoch          BigInt
  issuedAt       DateTime    @default(now())
  ackedAt        DateTime?
  drainedAt      DateTime?
  declaredLostAt DateTime?
  Host           SandboxHost @relation(fields: [hostId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([hostId, kidR])
  @@index([kidR])
  @@map("credential_host_return_key")
}

/// Every REJECTED capture outcome; replay returns it.
model CredentialCaptureRejection {
  hostId         String
  captureId      String
  envelopeDigest Bytes
  leaseId        String?
  bindingId      String?
  kidR           String
  reason         String
  at             DateTime  @default(now())
  discardedAt    DateTime?
  // @check credential_capture_rejection_digest: octet_length("envelopeDigest") = 32

  @@id([hostId, captureId, envelopeDigest])
  @@index([leaseId], map: "credential_capture_rejection_live", where: raw("\"discardedAt\" IS NULL"))
  @@map("credential_capture_rejection")
}

/// A login attached to a sandbox. Requested ids are a one-shot placement hint,
/// not a pin; accountId/instanceId record the last lease taken.
model SandboxCredential {
  id                  String     @id @default(cuid(2))
  sandboxId           String
  userId              String
  credentialId        String
  requestedAccountId  String?
  requestedInstanceId String?
  accountId           String?
  instanceId          String?
  attachedAt          DateTime   @default(now())
  detachedAt          DateTime?
  User                User       @relation("SandboxCredentialOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  Sandbox             Sandbox    @relation(fields: [sandboxId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)
  Credential          Credential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([sandboxId, credentialId], map: "sandbox_credential_active", where: raw("\"detachedAt\" IS NULL"))
  @@index([credentialId, detachedAt])
  @@index([sandboxId, attachedAt])
  @@map("sandbox_credential")
}

/// Non-secret dispatch spec (canonical JSON), fetched by the host in chunks.
model CredentialOperationSpec {
  operationId String           @id
  digest      Bytes
  bytes       Bytes
  createdAt   DateTime         @default(now())
  Operation   SandboxOperation @relation(fields: [operationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  // The one spec cap (specMaxBytes in packages/config/src/credential-protocol-limits.json).
  // @check credential_operation_spec_size: octet_length("digest") = 32 AND octet_length("bytes") <= 1179648

  @@map("credential_operation_spec")
}

model CredentialLoginSession {
  id               String                      @id @default(cuid(2))
  userId           String
  credentialId     String
  accountId        String
  instanceId       String
  sandboxId        String?
  state            CredentialLoginSessionState @default(PROVISIONING)
  foreignConsentAt DateTime?
  expiresAt        DateTime
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @default(now()) @updatedAt
  User             User                        @relation("CredentialLoginSessionOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  Credential       Credential                  @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, state])
  @@map("credential_login_session")
}

/// Metadata-only audit/event log. Never carries a value.
model CredentialEvent {
  id           String   @id @default(cuid(2))
  userId       String
  credentialId String
  accountId    String?
  instanceId   String?
  leaseId      String?
  sandboxId    String?
  type         String
  storageSeq   Int?
  hostId       String?
  sizeBytes    Int?
  reason       String?
  at           DateTime @default(now())
  User         User     @relation("CredentialEventOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, credentialId, at])
  @@map("credential_event")
}

model SdkKeyCredentialAllowlist {
  id           String     @id @default(cuid(2))
  createdAt    DateTime   @default(now())
  userId       String
  sdkKeyId     String
  credentialId String
  User         User       @relation("SdkKeyCredentialAllowlistOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  SdkKey       SdkKey     @relation(fields: [sdkKeyId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)
  Credential   Credential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([sdkKeyId, credentialId])
  @@index([credentialId, userId])
  @@map("sdk_key_credential_allowlist")
}

/// DB key-epoch write fence shared by every encrypted writer (vault and webhooks).
model DataKeyEpoch {
  id          Int      @id
  currentKid  String
  previousKid String?
  epoch       BigInt
  switchedAt  DateTime @default(now())
  // @check data_key_epoch_singleton: "id" = 1 AND "epoch" >= 1 AND "currentKid" ~ '^[0-9a-f]{16}$' AND ("previousKid" IS NULL OR "previousKid" ~ '^[0-9a-f]{16}$')

  @@map("data_key_epoch")
}
