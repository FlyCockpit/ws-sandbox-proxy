{
  "schemaVersion": 1,
  "id": "example-api-proxy",
  "displayName": "Example API key (proxied)",
  "login": { "command": "true", "method": "paste" },
  "credentials": {
    "env": [
      {
        "name": "EXAMPLE_API_KEY",
        "description": "Never enters the guest; the host proxy adds it.",
        "required": true,
        "proxy": {
          "upstream": "https://api.example.com/v1",
          "header": "Authorization",
          "format": "Bearer {value}",
          "baseUrlEnv": "EXAMPLE_BASE_URL",
          "placeholderEnv": "EXAMPLE_API_KEY"
        }
      },
      {
        "name": "EXAMPLE_ORG_KEY",
        "required": false,
        "proxy": {
          "upstream": "https://org.example.net:8443/api/v2/%C3%A9t%20e",
          "header": "x-api-key",
          "format": "{value}",
          "baseUrlEnv": "EXAMPLE_ORG_BASE_URL"
        }
      }
    ],
    "sharing": "shareable",
    "rotates": "no"
  }
}
