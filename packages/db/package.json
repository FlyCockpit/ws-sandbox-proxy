{
  "name": "@wssp/db",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./account-deletion": {
      "default": "./src/account-deletion.ts"
    },
    "./admin-governance": {
      "default": "./src/admin-governance.ts"
    },
    "./authority": {
      "default": "./src/authority.ts"
    },
    "./client": {
      "default": "./src/client.ts"
    },
    "./credential-security": {
      "default": "./src/credential-security.ts"
    },
    "./session-revocation": {
      "default": "./src/session-revocation.ts"
    },
    "./seed": {
      "default": "./prisma/seed.ts"
    },
    "./testing/pg": {
      "default": "./src/testing/pg.ts"
    },
    "./terminal-proof": {
      "default": "./src/terminal-proof.ts"
    },
    "./instance-heartbeat": {
      "default": "./src/instance-heartbeat.ts"
    },
    "./data-deletion-notices": {
      "default": "./src/data-deletion-notices.ts"
    },
    "./runner-tables": {
      "default": "./src/runner-tables.ts"
    }
  },
  "scripts": {
    "db:seed": "bash ../../scripts/assert-local-database.sh db:seed && prisma db seed",
    "db:generate": "node prisma/generate-client.mjs",
    "db:validate": "prisma validate && prisma format && prisma format --check",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "postinstall": "node prisma/generate-client.mjs",
    "db:studio": "bash ../../scripts/assert-local-database.sh db:studio && prisma studio",
    "test:pg": "vitest run --config ../../vitest.pg.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "catalog:",
    "@wssp/env": "workspace:*",
    "dotenv": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:",
    "prisma": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wssp/config": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
