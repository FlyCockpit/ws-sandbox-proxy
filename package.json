{
  "name": "wssp",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/FlyCockpit/ws-sandbox-proxy.git"
  },
  "homepage": "https://github.com/FlyCockpit/ws-sandbox-proxy",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:raw": "WORKER_MODE=external turbo dev",
    "build": "turbo build",
    "test": "turbo run test",
    "test:pg": "node scripts/test-pg.mjs",
    "test:pg:pull-image": "node scripts/lib/disposable-postgres.mjs pull",
    "test:s3": "node scripts/test-s3.mjs",
    "test:s3:pull-image": "node scripts/test-s3.mjs pull",
    "check-types": "turbo check-types && pnpm check-types:scripts",
    "check-types:scripts": "tsc -p tsconfig.scripts.json",
    "lint": "biome lint . && pnpm policy:prisma-query-casts && pnpm lint:design",
    "lint:design": "oxlint",
    "format": "biome format --write .",
    "check": "biome check --write . && pnpm policy:prisma-query-casts",
    "check:ci": "biome check . && pnpm policy:prisma-query-casts && pnpm policy:prisma-query-casts:test && pnpm lint:design",
    "verify": "pnpm check:ci && pnpm policy:checks && pnpm policy:template-secrets && pnpm policy:local-db-guard && pnpm policy:agents-size && pnpm policy:test-colocation && pnpm policy:queue-wiring && pnpm policy:access-matrix && pnpm policy:pg-image-ci && pnpm check-types && pnpm test && pnpm test:pg && pnpm test:cancel-wire && pnpm test:relay-chaos && pnpm test:setup && pnpm knip && pnpm env:check && pnpm env:check-entrypoints && pnpm docker:check-copy && pnpm docs:check-citations && pnpm deps:check-excludes && pnpm db:test-unit && pnpm backup:test-unit && pnpm db:test-migrations && pnpm backup:test",
    "verify:fast": "pnpm biome check . && pnpm deps:check-excludes && pnpm policy:prisma-query-casts && pnpm policy:pg-image-ci && pnpm lint:design && pnpm policy:agents-size && pnpm policy:test-colocation && pnpm policy:queue-wiring && pnpm policy:access-matrix && pnpm policy:principal-kinds && pnpm docs:check-citations && pnpm env:check && pnpm policy:checks && pnpm policy:template-secrets && pnpm turbo check-types --affected --output-logs=errors-only && pnpm check-types:scripts && node scripts/verify-fast-tests.ts && pnpm test:cancel-wire && pnpm test:setup && pnpm policy:local-db-guard && pnpm db:test-unit && pnpm backup:test-unit",
    "verify:tooling": "pnpm policy:checks:self-test && pnpm policy:hooks && pnpm policy:trufflehog-filter && pnpm policy:access-matrix:self-test && pnpm dokploy:test && pnpm policy:local-db-guard && pnpm db:test-unit && pnpm backup:test-unit",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:worker": "turbo -F worker dev",
    "db:seed": "turbo -F @wssp/db db:seed",
    "db:studio": "turbo -F @wssp/db db:studio",
    "runtime:test-operations": "node scripts/test-runtime-operations.mjs --disposable-services",
    "dokploy:config": "node --import tsx scripts/generate-dokploy-config.ts",
    "dokploy:verify": "node scripts/verify-dokploy-deployment.mjs",
    "dokploy:test": "node scripts/test-dokploy-deployment.mjs && node --import tsx scripts/generate-dokploy-config.test.ts",
    "db:generate": "turbo -F @wssp/db db:generate",
    "db:validate": "turbo -F @wssp/db db:validate",
    "dev:services": "bash scripts/compose.sh -f docker-compose.dev.yml up -d",
    "dev:services:stop": "bash scripts/compose.sh -f docker-compose.dev.yml down",
    "dev:s3": "node scripts/dev-s3.mjs",
    "dev:s3:stop": "node scripts/dev-s3.mjs stop",
    "dev:tunnel": "bash scripts/dev-tunnel.sh",
    "dev:tunnel:down": "bash scripts/dev-tunnel.sh down",
    "dev:docker": "bash scripts/dev-docker.sh",
    "dev:docker:logs": "bash scripts/dev-docker-logs.sh",
    "dev:docker:down": "bash scripts/dev-docker-down.sh",
    "find-free-port": "bash scripts/find-free-port.sh",
    "generate:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "generate:vapid": "pnpm -F @wssp/api exec web-push generate-vapid-keys",
    "generate:secrets": "tsx scripts/generate-secrets.ts",
    "env:sync": "tsx scripts/sync-env-example.ts",
    "env:check": "tsx scripts/sync-env-example.ts --check",
    "env:check-entrypoints": "tsx scripts/check-load-dotenv-contract.ts",
    "docker:check-copy": "node --import tsx scripts/check-docker-copy.ts --self-test && node --import tsx scripts/check-docker-copy.ts",
    "deps:check-excludes": "tsx scripts/check-release-age-excludes.ts",
    "docs:check-citations": "node --import tsx --test scripts/lib/doc-links.test.ts && tsx scripts/check-doc-citations.ts",
    "policy:prisma-query-casts": "node scripts/check-prisma-query-cast-policy.ts --scan",
    "policy:prisma-query-casts:test": "node scripts/test-prisma-query-cast-policy.ts",
    "policy:checks": "bash scripts/policy-checks.sh",
    "policy:checks:self-test": "bash scripts/policy-checks.sh --self-test",
    "policy:hooks": "node scripts/claude-hooks/pre-tool-use.mjs --self-test && tsx scripts/test-install-claude-hooks.ts",
    "policy:trufflehog-filter": "node scripts/filter-trufflehog-results.mjs --cli-test",
    "policy:template-secrets": "node scripts/check-template-secret-patterns.mjs --self-test && node scripts/check-template-secret-patterns.mjs",
    "policy:local-db-guard": "bash scripts/assert-local-database.sh --self-test",
    "policy:pg-image-ci": "node --test scripts/lib/disposable-postgres.test.mjs scripts/lib/test-container-prefix.test.mjs scripts/test-pg.test.mjs",
    "claude:hooks:install": "tsx scripts/install-claude-hooks.ts",
    "policy:test-colocation": "node scripts/check-test-colocation.ts",
    "policy:queue-wiring": "node scripts/check-queue-wiring.ts",
    "policy:agents-size": "node scripts/check-agents-size.ts",
    "policy:access-matrix": "node scripts/check-access-matrix.ts",
    "policy:access-matrix:self-test": "node scripts/check-access-matrix.ts --self-test",
    "policy:principal-kinds": "pnpm --filter @wssp/api exec vitest run src/sandbox/principal-kinds.lint.test.ts",
    "setup": "tsx scripts/setup.ts",
    "test:cancel-wire": "cargo build -p wssp --bin wssp --locked && vitest run --config scripts/vitest-cancel-wire.config.ts",
    "test:relay-chaos": "cargo build -p wssp --bin wssp --locked && vitest run --config scripts/vitest-relay-chaos.config.ts",
    "test:relay-chaos:full": "cargo build -p wssp --bin wssp --locked && vitest run --config scripts/vitest-relay-chaos.config.ts --mode full",
    "test:e2e:mcp": "node --import tsx scripts/e2e/mcp-agent-access.mjs",
    "test:offload:live": "node --import tsx scripts/offload-live.ts",
    "test:relay-chaos:live": "node --import tsx scripts/relay-chaos-live.ts",
    "test:setup": "node --import tsx --test scripts/lib/admin-email-env.test.ts scripts/lib/env-file.test.mjs scripts/dev-docker.test.mjs scripts/theme-apply.test.ts scripts/lib/drift-test-packages.test.ts scripts/lib/relay-chaos-live.test.ts scripts/lib/relay-chaos-front-door.test.ts scripts/offload-live.test.ts scripts/install-pnpm.test.mjs",
    "check:lazy-xterm": "node scripts/check-lazy-xterm.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "data-key:status": "tsx packages/api/src/crypto/data-key.cli.ts status",
    "data-key:promote": "tsx packages/api/src/crypto/data-key.cli.ts promote",
    "doctor:react": "react-doctor . --offline -y",
    "doctor:react:diff": "react-doctor . --scope changed --base origin/main --offline -y",
    "knip": "knip",
    "knip:production": "knip --production",
    "sync:agent-docs": "tsx scripts/sync-agent-docs.ts",
    "theme:apply": "node --import tsx scripts/theme-apply.ts",
    "i18n:translate": "tsx scripts/translate-locale-bundles.ts",
    "i18n:translate:mailer": "tsx scripts/translate-locale-bundles.ts --source-dir packages/mailer/src/locales/en-US --target-dir packages/mailer/src/locales/es-MX",
    "postinstall": "lefthook install",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:migrate:apply": "node scripts/db/apply.mjs",
    "db:migrate:rebase": "node scripts/db/rebase.mjs",
    "db:worktree": "node scripts/db/worktree.mjs",
    "db:reset:local": "node scripts/db/reset-local.mjs",
    "db:check-migrations": "node scripts/db/check-migrations.mjs",
    "db:test-migrations": "node scripts/db/test-migrations.mjs",
    "db:test-unit": "node --test scripts/db/*.test.mjs scripts/db/lib/*.test.mjs scripts/lib/bounded-child.test.mjs",
    "backup:test-unit": "node --test scripts/backup/*.test.mjs",
    "backup:test": "node scripts/backup/test-backup-restore.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@wssp/env": "workspace:*",
    "@wssp/i18n-translate": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/parser": "catalog:",
    "@biomejs/biome": "^2.6.6",
    "@inquirer/prompts": "^8.7.5",
    "@shadcn/lint": "0.2.5",
    "@types/node": "catalog:",
    "@wssp/config": "workspace:*",
    "knip": "^6.44.2",
    "lefthook": "^2.2.2",
    "oxlint": "^1.93.0",
    "pg": "catalog:",
    "react-doctor": "^0.9.22",
    "tree-sitter-bash": "0.25.1",
    "tsx": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "web-tree-sitter": "0.27.2",
    "@modelcontextprotocol/client": "catalog:"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
