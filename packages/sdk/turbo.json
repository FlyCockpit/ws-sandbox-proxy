{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.mts",
        "test/**/*.json",
        "tsdown.config.ts",
        "README.md",
        "examples/**/*.ts",
        // fs-process.test.ts reads docs beyond the guide; docs-examples.test.ts
        // checks guide env names against the Rust sources; commands.test.ts
        // reads the shared env fixture.
        "$TURBO_ROOT$/docs/**/*.md",
        "$TURBO_ROOT$/scripts/lib/env-manifest.ts",
        "$TURBO_ROOT$/apps/cli/src/**/*.rs",
        "$TURBO_ROOT$/crates/**/*.rs",
        "$TURBO_ROOT$/crates/sandbox-protocol/fixtures/env_cases.json",
        "tsconfig.json",
        "package.json"
      ]
    }
  }
}
