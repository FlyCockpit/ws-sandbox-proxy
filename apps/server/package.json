{
  "name": "server",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "test": "vitest run --passWithNoTests",
    "test:pg": "vitest run --config ../../vitest.pg.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@wssp/api": "workspace:*",
    "@wssp/auth": "workspace:*",
    "@wssp/db": "workspace:*",
    "@wssp/env": "workspace:*",
    "@wssp/queue": "workspace:*",
    "@wssp/sandbox-contracts": "workspace:*",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "rate-limiter-flexible": "catalog:",
    "worker": "workspace:*",
    "ws": "catalog:",
    "zod": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@better-auth/mcp": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "@wssp/config": "workspace:*",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:"
  }
}
