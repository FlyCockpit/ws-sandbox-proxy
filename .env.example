# =============================================================================
# GENERATED FROM scripts/lib/env-manifest.ts — DO NOT EDIT BY HAND.
# Add or change a variable in that manifest, then run `pnpm env:sync`.
#
# This is the single canonical .env location — loaded by every package.
# Copy to .env and fill in real values: cp .env.example .env
# Do NOT create per-app .env files (e.g. apps/server/.env).
#
# For a PRODUCTION environment, don't fill this in by hand — run
# `pnpm generate:secrets`. It generates the random values, prompts only for
# what it can't know, skips whatever your deploy platform injects, and
# validates the result before printing it.
#
# Server vs worker: the env package is split. The BullMQ worker validates
# only the worker-safe (shared) surface — DATABASE_URL, REDIS_URL,
# NODE_ENV, the BACKUP_* block, SMTP, and the translation
# keys. The server-only vars (BETTER_AUTH_*, CORS_ORIGIN,
# SIGNUP_ENABLED, VAPID_*, ADMIN_EMAILS, RATE_LIMIT_*,
# SSR_CACHE_TTL_SECONDS) are NOT required by a
# worker-only deployment. For local dev you set everything in one file
# regardless; the split only matters when server and worker run on
# separate hosts. Sections are tagged [shared] or [server-only].
#
# Structure: core/required vars first, then optional feature blocks
# (shipped commented out — uncommenting a block is what turns the feature
# on), then one clearly-marked Advanced tuning section of one-off knobs,
# each commented with its working default. The FULL variable catalog —
# including runtime identity and harness controls omitted from
# normal services — lives in scripts/lib/env-manifest.ts.
#
# NOTE: There is no auth-bypass mode. To exercise the real signup →
# email-verification → 2FA flow locally, use `pnpm dev:docker` — it ships
# an in-stack mailpit SMTP sink that captures verification email offline
# with zero credentials.
# =============================================================================

# --- Datastores — [shared] (server + worker) -------------------------------

# e.g. postgresql://user:password@host:5432/dbname — or leave blank to omit and set it on the platform
DATABASE_URL=postgresql://postgres:password@localhost:5432/wssp
# e.g. redis://default:password@host:6379 (BullMQ + rate limiting) — or leave blank to omit and set it on the platform
REDIS_URL=redis://localhost:6379

# --- Runtime + schema sync — [shared] --------------------------------------
# Committed Prisma migrations run at startup when MIGRATE_ON_START=true.
# Followers wait for matching history before admitting the application.
# See docs/schema-migrations.md.

# Set to `production` on every deployed environment. Several env guards
# escalate from a warning to a hard boot failure when this is `production`
# — that is intentional, do not weaken it to silence a startup error.
# Allowed: production | development | test
# NODE_ENV=production

# [server-only] embedded runs background jobs in the app (default).
# Set external only when deploying a dedicated worker with the same Redis/database.
# External mode never silently falls back; /ready fails if consumers disappear.
# WORKER_MODE=embedded

# --- Database backups — [shared] -------------------------------------------
# Logical pg_dump backups uploaded to a private bucket. Production
# requires a dedicated BACKUP_S3_ACCESS_KEY_ID,
# limited to GetObject, PutObject, and AbortMultipartUpload on the backup bucket. The freshness
# worker should use a distinct ListBucket-only monitor credential, not the
# dump-writer key.
# Use the regular image's backup-schedule command for opt-in UTC daily
# backups, and restore/restore-drill for explicit one-shot recovery.
# Set an explicit deployment-specific BACKUP_S3_PREFIX. See
# docs/operations/backup-and-restore.md.
#
# Disabled by default — uncomment to enable.

# Automatic backups default off: no migration snapshots, daily writer or
# freshness alerts. true (strict true|false): a migrating start FAILS when no
# destination (/backups volume or BACKUP_S3_BUCKET) is usable, and pending
# migrations get a dump first, a brand-new database included. Explicit
# backup commands and restore safety snapshots work either way.
# Allowed: true | false
# BACKUP_ENABLED=true
# Private bucket for pg_dump custom-format dumps. Use a dedicated bucket.
# BACKUP_S3_BUCKET=
# Required for dump writers. Must be a distinct GetObject/PutObject/AbortMultipartUpload key.
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# ListBucket-only key for the worker freshness check; never reuse the dump read/write key.
# BACKUP_MONITOR_S3_ACCESS_KEY_ID=
# BACKUP_MONITOR_S3_SECRET_ACCESS_KEY=
# "auto" for Cloudflare R2; a real region for AWS S3
# BACKUP_S3_REGION=auto
# BACKUP_S3_ENDPOINT=
# Explicit nonempty prefix unique to this deployment; use the identical prefix for writer and monitor.
# BACKUP_S3_PREFIX=

# --- Template image store — [shared] (server + worker) ---------------------
# Template image distribution between hosts. With no bucket, images are
# copied between the owner's own hosts through the server (peer mode).
# Setting IMAGE_S3_BUCKET plus both keys turns on S3 mode (R2, MinIO, S3).
# Use a dedicated bucket-scoped key, never BACKUP_S3_*. Set the same values
# on server AND worker. See docs/operations/templates.md#image-store.

# auto (S3 when a bucket and keys are set, else peer) or off (no image distribution, capture or lease-from-READY).
# IMAGE_DISTRIBUTION=auto
# S3 API endpoint (https; http only on loopback). R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# IMAGE_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Private bucket for template images. Setting it (plus both keys) turns on S3 mode.
# IMAGE_S3_BUCKET=
# Dedicated key scoped to the image bucket (Object Read and Write).
# IMAGE_S3_ACCESS_KEY_ID=
# Secret for IMAGE_S3_ACCESS_KEY_ID.
# IMAGE_S3_SECRET_ACCESS_KEY=
# true for MinIO; recommended for R2.
# IMAGE_S3_FORCE_PATH_STYLE=false
# on encrypts stored images with per-image data keys (AES-256-GCM).
# IMAGE_STORE_ENCRYPTION=off
# base64 of 32 random bytes (openssl rand -base64 32). Required when IMAGE_STORE_ENCRYPTION=on.
# IMAGE_STORE_ENCRYPTION_KEY=

# --- Auth — [server-only] --------------------------------------------------

# REQUIRED, minimum 32 characters. The env validator rejects weak and
# placeholder values in production. Rotating this invalidates every
# existing session and all product credentials (host tokens, device
# credentials, SDK keys) — generate once per environment and keep it stable.
#
# For LOCAL dev this is filled in for you by `pnpm setup:app`; to mint one
# by hand use `pnpm generate:secret` and paste it below. For a PRODUCTION
# environment prefer `pnpm generate:secrets`, which generates this along
# with the rest of the block and validates the result.
BETTER_AUTH_SECRET=
# Origin only — no path, query, hash, or credentials. e.g. https://app.example.com
BETTER_AUTH_URL=https://wssp.localhost

# Optional. Set ONLY when the browser app runs on a different origin than
# the API (raw web dev, split-origin deploys). Leave unset for the default
# same-origin flow. No path, query, or hash.
# CORS_ORIGIN=https://app.example.com

# --- Admin + signup — [server-only] ----------------------------------------

# These accounts get admin privileges. Emails are trimmed and lowercased. Bootstrap-only: after provisioning, admins persist in the database and this list can be cleared. An empty list with SIGNUP_ENABLED=false (the default) only warns at boot — on a fresh install with no admin yet, nobody can become admin.
# ADMIN_EMAILS=admin@example.com,other@example.com

# Public signup defaults to disabled. The signupEnabled app setting, when
# present, overrides this deployment default for signup and the form.
# Setting this default to true REQUIRES SMTP below: email verification is
# enforced and the server refuses to boot without SMTP.
# SIGNUP_ENABLED=false

# --- Email (SMTP) — [shared] -----------------------------------------------
# REQUIRED if SIGNUP_ENABLED=true — Better-Auth enforces email verification
# on signup, and the server refuses to boot in production without it.
# Local dev: docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
#   then set SMTP_HOST=localhost, SMTP_PORT=1025, open http://localhost:8025
#
# Disabled by default — uncomment to enable.

# e.g. smtp.resend.com, smtp.postmarkapp.com, email-smtp.us-east-1.amazonaws.com
# SMTP_HOST=localhost
# 587 for STARTTLS (most providers), 465 for implicit TLS, 1025 for a local mailpit sink
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# e.g. "App Name <no-reply@yourdomain.com>". Required whenever SMTP_HOST is set.
# SMTP_FROM=noreply@example.com

# --- Web Push (VAPID) — [server-only] --------------------------------------
# Optional — the app runs fine without these. Set ALL THREE or none.
# The keypair is generated for you by `pnpm generate:secrets`; you supply
# VAPID_SUBJECT, a real mailto: or https: URL push services use to reach
# YOU about delivery problems.
#
# Disabled by default — uncomment to enable.

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# A mailto: or https: URL push services use to contact YOU about delivery problems. Use a real, monitored address.
# VAPID_SUBJECT=mailto:you@yourdomain.com

# --- Translation provider — [shared] ---------------------------------------
# Used by `pnpm i18n:translate`.
# The app boots without these; the worker throws on the first job if the
# chosen provider's key is missing. Default provider is `openrouter` with
# `anthropic/claude-haiku-4-5` (~$0.05 for a full UI bundle).
#
# Disabled by default — uncomment to enable.

# Allowed: openrouter | anthropic
# TRANSLATION_PROVIDER=openrouter
# Required when TRANSLATION_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# Required when TRANSLATION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- Sandbox host relay — [server] -----------------------------------------
# Outbound WebSocket relay for trusted sandbox node daemons
# (`apps/server/src/sandbox-relay`), always enabled with host-plane authentication.

# Maximum hosts one account may have (1-100000, including hosts pending deletion), or "unlimited". Enforced at host creation and device-login enrollment.
# SANDBOX_MAX_HOSTS_PER_OWNER=20
# Maximum concurrent node-daemon WebSockets per host on one server process (1-64). Extra connections are refused with a protocol error naming this limit.
# SANDBOX_MAX_SOCKETS_PER_HOST=2
# Private persistent server spool directory; Compose mounts the server-data volume at /app/.data. One server process only.
# TRANSFER_SPOOL_DIR=.data/transfers
# Maximum transfer length in bytes (default and hard ceiling 1 GiB, the node daemon's limit; lower values allowed, higher ones fail startup).
# TRANSFER_MAX_BYTES=1073741824
# Aggregate reserved transfer bytes (default 10 GiB); provision disk plus filesystem overhead.
# TRANSFER_DISK_BYTES=10737418240
# Maximum open transfers per owner; a settled upload or a fully delivered download frees its slot at once.
# TRANSFER_OWNER_ACTIVE=4
# Maximum open transfers and in-flight spool operations per server.
# TRANSFER_GLOBAL_ACTIVE=16
# Idle expiry in seconds; successful chunks and reads refresh it.
# TRANSFER_IDLE_SECONDS=900
# Absolute transfer expiry in seconds; never extended by activity.
# TRANSFER_ABSOLUTE_SECONDS=3600

# REQUIRED server-only master for future keyed sandbox request/config digests.
# Generate with secret32 via pnpm generate:secrets (32 random bytes, lowercase hex).
# At least 64 even hex characters; weak/placeholder values fail in every environment.
# Share one stable key across server replicas; store/backup externally in production.
# Dev: `vite dev` runs SSR server functions, so web#dev gets it too (apps/web/turbo.json).
# Never expose it to hosts, guests or logs. Rotation requires quiescence and retirement
# of retained configs under the old key; restoring the original key is recovery.
SANDBOX_REQUEST_HMAC_SECRET=
# Owner create/connect procedure budget: 1..10000 points.
# SANDBOX_CREATE_CONNECT_BUDGET_POINTS=300
# Owner create/connect budget window: 60..3600 seconds.
# SANDBOX_CREATE_CONNECT_BUDGET_WINDOW_SECONDS=60
# Deployment maximum sandbox lease: 300000..2073600000 ms, or unlimited (allows timeoutMs 0).
# SANDBOX_MAX_TIMEOUT_MS=86400000
# Longest a pool create may wait for capacity (waitForCapacityMs): 0..2073600000 ms (0 disables waits), or "unlimited". Pools may set a lower limit.
# SANDBOX_CAPACITY_WAIT_MAX_MS=3600000
# Waiting pool creates one SDK key may hold across all pools (0-100000), or "unlimited". Pools may set a lower limit.
# SANDBOX_CAPACITY_QUEUE_MAX_PER_KEY=16
# Waiting pool creates one account may hold across all pools (0-100000), or "unlimited". Pools may set a lower per-pool limit.
# SANDBOX_CAPACITY_QUEUE_MAX_PER_OWNER=64

# --- Data encryption root key — [shared] (server + worker) -----------------
# DATA_ENCRYPTION_KEY is the one deployment-wide root key for data at rest.
# Each purpose (webhook endpoint secrets, the CLI-login vault) derives its own
# sub-key with HKDF-SHA256. The server and the worker MUST share the same value;
# unset turns webhooks and CLI logins off. Store it apart from database
# backups: losing it makes every value encrypted under it unrecoverable.
# Rotate via DATA_ENCRYPTION_KEY_PREVIOUS; see
# docs/operations/production-hardening.md.

# Root key for data at rest: exactly 64 lowercase hex characters (32 random bytes).
# Generate with: openssl rand -hex 32. Same value on server and worker. Never derived
# from BETTER_AUTH_SECRET; keep it out of database backups.
DATA_ENCRYPTION_KEY=

# --- Outbound webhooks — [shared] (server + worker) ------------------------
# Endpoint signing secrets are encrypted under a sub-key of DATA_ENCRYPTION_KEY
# (data-encryption section above); without it webhooks are off.
# The worker needs outbound internet access. Private destinations are
# refused unless allowlisted below; see docs/guide/webhooks.md and
# docs/operations/production-hardening.md § Webhook egress.
#
# Disabled by default — uncomment to enable.

# CSV of private CIDRs webhook deliveries may reach (e.g. a tailnet /32). Hard-denied ranges fail at boot.
# WEBHOOK_ALLOWED_PRIVATE_CIDRS=
# CSV of exact hostnames that may resolve to private addresses (used only when no CIDRs are set).
# WEBHOOK_ALLOWED_PRIVATE_HOSTS=
# Which accounts may use the private allowlist. Keep `admins` unless every account is trusted.
# Allowed: admins | all
# WEBHOOK_PRIVATE_ALLOWLIST_SCOPE=admins
# Allow http:// to allowlisted private destinations only. Public destinations always need https.
# WEBHOOK_ALLOW_PLAINTEXT_PRIVATE=false

# --- Advanced tuning -------------------------------------------------------
# One-off tuning knobs, grouped by feature. Every value has a working
# default shown on its line — uncomment and change ONLY the one you need.
# Rate-limit budgets rescale their whole limiter family coherently
# (multiplier = provided / reference); tighter is not safer — see
# docs/operations/production-hardening.md. Deeper operational knobs (harness controls,
# runtime identities) are deliberately absent from this file;
# the full catalog lives in scripts/lib/env-manifest.ts.

# === Datastores — [shared] (server + worker) ===

# Max connections in this process's Postgres pool (node-postgres `max`).
# Default 10 matches the driver default — raise it only against the
# database's connection budget, since every server/worker replica holds its own pool.
# Every server/worker replica holds its own pool against the same database.
# Each server process also opens at most 2 more, outside this pool, for the CLI connect audit.
# DATABASE_POOL_MAX=10

# === Auth — [server-only] ===

# Exact number of trusted reverse proxies in front of the server, for the
# client IP used as the anonymous rate-limit and audit key. Unset or 0 keys
# on the TCP socket peer and ignores X-Forwarded-For. Behind a proxy, 0
# puts every client in ONE shared bucket (the proxy's address); set the
# exact count (the generated Dokploy config sets 1 for Traefik, or N with
# --trust-proxy-hops N; 2 for a Cloudflare Tunnel into Traefik). N >= 1
# takes the entry N from the right of X-Forwarded-For plus the socket peer
# (an appended :port is stripped); a short or malformed chain falls back
# to the socket peer. Above 0, the
# app must be reachable only through that proxy chain.
# TRUST_PROXY_HOPS=1

# === Rate limiting — [server-only] ===
# Three named budgets (AUTH, RPC, EMAIL), two knobs
# each. Each budget describes its family's reference member; every other
# limiter in the family scales with it at its designed ratio, so setting
# a budget re-tunes the whole family coherently. Defaults are sensible;
# tighter is not safer — if a surface 429s legitimate users, split the
# surface instead of shrinking a budget. The native /v1 SDK API has three
# separate absolute budgets (RATE_LIMIT_SDK_*), one per dimension, that do
# not scale with any family. See docs/operations/production-hardening.md.

# Auth family reference: requests per IP per window on the general /api/auth/* surface (password reset, verification, session ops). Setting it rescales the whole fail-closed auth family at each member's designed ratio: credential 10, credential-burst 3/10s, signup 10/h, 2FA-OTP 3/15min.
# RATE_LIMIT_AUTH_POINTS=30
# Window (seconds) for the auth family reference. Scales every auth-family window AND block duration by the same factor.
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# RPC family reference: requests per user (per IP signed out) per window on /rpc/*. /ready (60) and SSR (300) scale with it. Native /v1 does not; it has its own RATE_LIMIT_SDK_* budgets. One batched request can carry up to ORPC_BATCH_MAX_SIZE procedures.
# RATE_LIMIT_RPC_POINTS=100
# Window (seconds) for the RPC family reference; scales the /ready and SSR windows with it.
# RATE_LIMIT_RPC_WINDOW_SECONDS=60
# Native /v1 SDK API: requests per client IP per 60 s, charged before authentication (covers /v1/openapi.json). Absolute value, positive integer; does not scale with RATE_LIMIT_RPC_*. Fails closed.
# RATE_LIMIT_SDK_IP_POINTS=300
# Native /v1 SDK API: requests per SDK key per 60 s, charged after authentication. Absolute value, positive integer; does not scale with RATE_LIMIT_RPC_*. Fails closed.
# RATE_LIMIT_SDK_KEY_POINTS=100
# Native /v1 SDK API: requests per owner (all of one user's SDK keys together) per 60 s, charged after the key budget. Absolute value, positive integer; does not scale with RATE_LIMIT_RPC_*. Fails closed.
# RATE_LIMIT_SDK_OWNER_POINTS=300
# Email family reference: mails per RECIPIENT per window on the anonymous send-mail endpoints (verification resend, password reset). Signup (6) and sign-in-triggered mails (10) scale with it. Keyed on the mailbox, so rotating IPs cannot flood one inbox. 0 disables the whole recipient family.
# RATE_LIMIT_EMAIL_POINTS=3
# Window (seconds) for the email family reference; scales all three recipient buckets with it.
# RATE_LIMIT_EMAIL_WINDOW_SECONDS=3600

# === Cache limits — [server-only] ===
# Optional tuning. Sensible defaults are built in.

# In-memory SSR HTML cache for anonymous GETs of public routes. 0 disables
# it. Public content edits can take up to this long to appear live.
# Public content edits can take up to this long to appear live.
# SSR_CACHE_TTL_SECONDS=60
