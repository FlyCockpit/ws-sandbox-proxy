generator client {
  provider        = "prisma-client"
  output          = "../generated"
  moduleFormat    = "esm"
  runtime         = "nodejs"
  previewFeatures = ["postgresqlExtensions", "partialIndexes"]
}

datasource db {
  provider   = "postgresql"
  // `pg_trgm` backs the GIN trigram indexes on the ILIKE-filtered columns
  // (User.email/name). It ships in the
  // stock postgres:18.6 image used by docker-compose.dev.yml, packages/db/
  // docker-compose.yml, and Dokploy, and committed `0_init` creates it before the indexes.
  extensions = [pg_trgm]
}
