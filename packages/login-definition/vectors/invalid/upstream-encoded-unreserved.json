{
  "description": "unreserved characters are not escaped",
  "expect": "definition.invalid",
  "document": {
    "schemaVersion": 1,
    "id": "proxy",
    "displayName": "Proxy",
    "login": {
      "command": "true",
      "method": "paste"
    },
    "credentials": {
      "env": [
        {
          "name": "KEY",
          "required": true,
          "proxy": {
            "upstream": "https://api.example.com/%41",
            "header": "Authorization",
            "format": "Bearer {value}",
            "baseUrlEnv": "KEY_BASE_URL"
          }
        }
      ]
    }
  }
}
