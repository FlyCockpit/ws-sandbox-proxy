{
  "version": 1,
  "homeRelative": [
    ".bash_history",
    ".zsh_history",
    ".python_history",
    ".node_repl_history",
    ".psql_history",
    ".mysql_history",
    ".sqlite_history",
    ".lesshst",
    ".viminfo",
    ".local/share/fish/fish_history",
    ".claude",
    ".claude.json",
    ".codex",
    ".config/gh",
    ".git-credentials",
    ".docker/config.json",
    ".npmrc",
    ".netrc",
    ".aws",
    ".config/gcloud",
    ".kube",
    ".ssh/id_*",
    ".gnupg"
  ],
  "absolute": [
    "/etc/ssh/ssh_host_*",
    "/var/lib/dbus/machine-id",
    "/var/log/journal",
    "/swap.img",
    "/swapfile",
    "/tmp/*",
    "/var/tmp/*",
    "/var/lib/cloud/*",
    "/var/log/cloud-init.log*",
    "/var/log/cloud-init-output.log*",
    "/etc/sudoers.d/wssp-guest",
    "/etc/.wssp-sudoers.tmp"
  ],
  "truncate": ["/etc/machine-id"],
  "homes": ["/root"]
}
