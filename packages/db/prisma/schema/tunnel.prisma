/// Preview tunnels (docs/guide/tunnels.md): the one tunnel server this
/// deployment's instance admin configured. Optional: no row means the
/// integration is off. The service credential is stored only as AES-256-GCM
/// ciphertext under the `tunnel-service-credential:v1` HKDF sub-key of
/// DATA_ENCRYPTION_KEY, bound by AAD to (row id, API URL); never projected by
/// reads.
model TunnelServerConfig {
  /// Always "default" (a singleton).
  id                   String    @id
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
  /// `https://host[:port]`, no path.
  apiUrl               String
  credentialCiphertext Bytes
  credentialNonce      Bytes
  credentialKeyId      String
  /// SHA-256 (hex) of the service credential: tells a re-sent credential
  /// from another one without the data key.
  credentialSha256     String
  /// This configuration's identity: minted once when it is created (from
  /// the URL, the credential's SHA-256 and a random salt) and never changed
  /// (docs/guide/tunnels.md#admin-configure-the-tunnel-server). Every
  /// tunnel row's remote state carries it; the configuration goes only when
  /// no row references it (or by the admin's remove-now, which forgets them).
  serverKey            String
  /// Live tunnels one account may hold across its sandboxes.
  maxTunnelsPerOwner   Int       @default(10)
  /// Turning off: set by the admin; the integration is off for callers while
  /// the controller deletes every tunnel with this credential, then removes
  /// this row.
  disabledAt           DateTime?
  /// Audit only: the admin who last set it.
  updatedById          String?

  // @check tunnel_server_config_singleton: id = 'default'
  // @check tunnel_server_config_max_per_owner: "maxTunnelsPerOwner" >= 1 AND "maxTunnelsPerOwner" <= 1000
  @@map("tunnel_server_config")
}

enum SandboxTunnelState {
  /// Wanted; waiting for a running sandbox on a connected host.
  PENDING
  CONNECTING
  CONNECTED
  /// The sandbox is stopped, offloaded or its host is away: no tunnel exists.
  SUSPENDED
  ERROR
}

/// One sandbox's wanted tunnel (ports ⊆ the sandbox's declared tunnelPorts)
/// and the control plane's view of it. The per-tunnel token is never stored:
/// every (re)apply mints or rotates one and sends it to the host only.
/// Deliberately NOT a foreign key to the sandbox or its owner: the row is the
/// remote-cleanup obligation and must outlive both; the controller deletes it
/// only after the tunnel server confirmed every tunnel labelled for it gone.
model SandboxTunnel {
  sandboxId     String             @id
  userId        String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  ports         Int[]
  state         SandboxTunnelState @default(PENDING)
  /// `tunnel_gone` | `replaced` | `client_failed` | `refused` | `quota` | `server_unavailable` | `host_full` | `not_shared`.
  lastError     String?
  /// The tunnel server's id of the live tunnel, when one exists.
  tunTunnelId   String?
  /// `{port}-<id>.<zone>` from the tunnel server.
  hostTemplate  String?
  /// The host the live tunnel was last applied to.
  hostId        String?
  /// Strictly increasing per apply; the host ignores older frames.
  generation    Int                @default(0)
  appliedAt     DateTime?
  connectedAt   DateTime?
  /// Closed by its owner: kept (with its generation, so a later expose
  /// never reuses one a host already saw) until the sandbox is deleted; the
  /// controller deletes its tunnel.
  closedAt      DateTime?
  /// A tunnel this row's controller made may exist without being recorded
  /// (a lost save): sweep the sandbox's label on the next pass.
  sweepLabel    Boolean            @default(false)
  /// A tunnel-server create or clean-up is in flight until this time (the
  /// row's hold): no other create, rotation or clean-up of the row meanwhile,
  /// and the row is not retired; an expired hold becomes a label sweep.
  creatingUntil DateTime?
  /// The `TunnelServerConfig.serverKey` this row's remote state (tunnel id,
  /// sweep, hold) was made with; null when it has none. Set only while that
  /// configuration is current; it cannot go while a row references it, so
  /// every cleanup and settlement uses (and compare-and-sets) this identity.
  /// A key with no tunnel id owes a label sweep.
  serverKey     String?

  // @check sandbox_tunnel_ports: cardinality(ports) >= 1 AND cardinality(ports) <= 8
  // @check sandbox_tunnel_generation: generation >= 0
  // @check sandbox_tunnel_server_key: "serverKey" IS NOT NULL OR ("tunTunnelId" IS NULL AND NOT "sweepLabel" AND "creatingUntil" IS NULL)
  @@unique([sandboxId, userId])
  @@index([userId])
  @@index([tunTunnelId])
  @@index([serverKey])
  @@map("sandbox_tunnel")
}

/// Tunnel audit (bounded by the 90-day prune in the tunnel controller):
/// config changes, enable/disable, port changes and link mints. Never a
/// token or link URL.
model SandboxTunnelEvent {
  id         String   @id @default(cuid(2))
  createdAt  DateTime @default(now())
  /// `config.set` | `config.cleared` | `tunnel.enabled` | `tunnel.disabled` | `ports.changed` | `tunnel.created` | `tunnel.deleted` | `link.minted`.
  kind       String
  /// The sandbox owner (null for config events).
  userId     String?
  sandboxId  String?
  /// The acting user (session) or SDK key id; null for the controller.
  actorId    String?
  actorKeyId String?
  port       Int?
  /// Tunnel-server ids only (tunnel id, access-link id).
  detail     String?

  @@index([createdAt])
  @@index([sandboxId, createdAt])
  @@map("sandbox_tunnel_event")
}
